Cell[CellGroupData[{

Cell["Core", "Subsection",
 CellChangeTimes->{{3.9964786712547398`*^9, 
  3.9964786716866302`*^9}},ExpressionUUID->"5599194a-3a0f-4b40-a3ec-\
340d4166810d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "function", " ", "searches", " ", "in", " ", "the", " ", 
    "parameter", " ", "space", " ", "for", " ", "variables", " ", "that", " ",
     "fit", " ", "the", " ", "PDG", " ", "limits", " ", "AND", " ", "the", 
    " ", "Mass", " ", "Ratios"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ScanProtonDecay", "[", 
     RowBox[{"nLimits_", ",", "numSamples_", ",", "maxCharge_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"results", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"massOnlyResults", "=", 
         RowBox[{"{", "}"}]}], ",", "tol", ",", "RctTeo", ",", "RutTeo", ",", 
        "RsbTeo", ",", "RdbTeo", ",", "massCheck", ",", 
        RowBox[{"massPassCount", "=", "0"}], ",", " ", "safetyFactors", ",", 
        "minRobustness", ",", "bottleneckIdx", ",", "channelNames", ",", 
        "bottleneck"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tol", "=", "5.0"}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"tolerance", " ", "O", 
         RowBox[{"(", "1", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"channelNames", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(e\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
          "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(\[Mu]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
          "\"\<p\[RightArrow] \!\(\*SuperscriptBox[\(e\), \
\(+\)]\)\!\(\*SuperscriptBox[\(K\), \(0\)]\)\>\"", ",", 
          "\"\<p\[RightArrow] \!\(\*SuperscriptBox[\(\[Mu]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(K\), \(0\)]\)\>\""}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Assign", " ", "ordered", " ", "random", " ", "values", " ", "to", 
          " ", "the", " ", "charges", " ", "but", " ", "ordered", " ", "for", 
          " ", "the", " ", "solution", " ", "to", " ", "be", " ", "as", " ", 
          "physical", " ", "as", " ", "possible", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Gen", " ", "1"}], ">", 
            RowBox[{"Gen", " ", "2"}], ">", 
            RowBox[{"Gen", " ", "3"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Qq1", ",", "Qq2"}], "}"}], "=", 
            RowBox[{"ReverseSort", "[", 
             RowBox[{"RandomSample", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", "maxCharge"}], "]"}], ",", "2"}], "]"}], 
             "]"}]}], ";", "\n", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"QeR1", ",", "QeR2"}], "}"}], "=", 
            RowBox[{"ReverseSort", "[", 
             RowBox[{"RandomSample", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", "maxCharge"}], "]"}], ",", "2"}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Ql2", "=", 
            RowBox[{"1", "-", "QeR2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Ql1", "=", 
            RowBox[{"4", "-", "QeR1"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"QuR3", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "2"}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"QuR2", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"QuR3", "+", "1"}], ",", 
               RowBox[{"maxCharge", "-", "1"}]}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"QuR1", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"QuR2", "+", "1"}], ",", "maxCharge"}], "}"}], "]"}]}],
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"QdR3", "=", 
            RowBox[{"QuR3", "+", "2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QdR2", "=", 
            RowBox[{"1", "+", "QuR2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QdR1", "=", "QuR1"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Qlq", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "20"}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"eps", "=", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0.1", ",", "0.3"}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\n", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Theorical", " ", "ratios", " ", "from", " ", "these", " ", 
             "random", " ", "charges", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "all", " ", "would", " ", "be", " ", "divided", " ", "by", " ", 
                RowBox[{"epsilon", "^", "0"}]}], "=", 
               RowBox[{
               "1", " ", "bc", " ", "we", " ", "are", " ", "normalizing", " ",
                 "to", " ", "the", " ", "3", "rd", " ", "gen", " ", "but", 
                " ", 
                RowBox[{"let", "'"}], "s", " ", "keep", " ", "it", " ", 
                "generical", " ", "in", " ", "case", " ", "we", " ", "want", 
                " ", "to", " ", "change", " ", "the", " ", "values", " ", 
                "of", " ", "the", " ", "3", "rd", " ", "generation", " ", 
                "charges"}]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"RucTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq1", "+", "QuR1"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QuR2"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RctTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QuR2"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq3", "+", "QuR3"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RdsTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq1", "+", "QdR1"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QdR2"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RsbTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QdR2"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq3", "+", "QdR3"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RbtTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Abs", "[", 
                RowBox[{"Qq3", "+", "QdR3"}], "]"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Abs", "[", 
                RowBox[{"Qq3", "+", "QuR3"}], "]"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RemuTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql1", "+", "QeR1"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql2", "+", "QeR2"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RmutauTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql2", "+", "QeR2"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql3", "+", "QeR3"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Vev", "=", 
            RowBox[{"eps", "*", "Lambda"}]}], ";"}], 
          RowBox[{"(*", "GeV", "*)"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"--", 
              RowBox[{"-", " ", "MASS"}]}], " ", "HIERARCHY", " ", 
             RowBox[{"FILTER", " ", "--"}]}], "-"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"massCheck", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", 
              RowBox[{"RucTeo", "/", "Ruc"}], "<=", "tol"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", 
              RowBox[{"RctTeo", "/", "Rct"}], "<=", "tol"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", 
              RowBox[{"RdsTeo", "/", "Rds"}], "<=", "tol"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", 
              RowBox[{"RsbTeo", "/", "Rsb"}], "<=", "tol"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", 
              RowBox[{"RbtTeo", "/", "Rbt"}], "<=", "tol"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", " ", 
              RowBox[{"RemuTeo", "/", "Remu"}], " ", "<=", "tol"}], " ", 
             ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "tol"}], "<=", 
              RowBox[{"RmutauTeo", "/", "Rmutau"}], "<=", "tol"}], ")"}]}]}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "If", " ", "the", " ", "charge", " ", "combination", " ", 
             "satisfies", " ", "the", " ", "mass", " ", "filter"}], ",", " ", 
            RowBox[{
            "then", " ", "work", " ", "with", " ", "the", " ", "decay", " ", 
             "widths", " ", "for", " ", "the", " ", "proton"}]}], " ", "*)"}],
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"massCheck", ",", 
            RowBox[{
             RowBox[{"massPassCount", "++"}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Reconstruct", " ", "the", " ", "coupling", " ", "matrices"}], 
              "*)"}], "\[IndentingNewLine]", 
             RowBox[{"yRR", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR1", "+", "QeR1", "+", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR1", "+", "QeR2", "+", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR1", "+", "QeR3", "+", "Qlq"}], "]"}]}]}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR2", "+", "QeR1", "+", "Qlq"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR2", "+", "QeR2", "+", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR2", "+", "QeR3", "+", "Qlq"}], "]"}]}]}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR3", "+", "QeR1", "+", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR3", "+", "QeR2", "+", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QdR3", "+", "QeR3", "+", "Qlq"}], "]"}]}]}], 
                 "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"zRR", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR1", "+", "QuR1", "-", "Qlq"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR1", "+", "QuR2", "-", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR1", "+", "QuR3", "-", "Qlq"}], "]"}]}]}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR2", "+", "QuR1", "-", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR2", "+", "QuR2", "-", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR2", "+", "QuR3", "-", "Qlq"}], "]"}]}]}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR3", "+", "QuR1", "-", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR3", "+", "QuR2", "-", "Qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"QuR3", "+", "QuR3", "-", "Qlq"}], "]"}]}]}], 
                 "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"Lifetime", " ", "Calculations"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"tauEpi0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KEpi0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"zRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                    RowBox[{"yRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "^", 
                   "2"}], " ", ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tauMupi0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KMupi0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"zRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                    RowBox[{"yRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "^", 
                   "2"}], " ", ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tauEK0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KEK0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"zRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                    RowBox[{"yRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], "^", 
                   "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tauMuK0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KMuK0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"zRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                    RowBox[{"yRR", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}], "^", 
                   "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
               "Save", " ", "a", " ", "sample", " ", "of", " ", "life", " ", 
                "times", " ", "bc", " ", "I", " ", "cant", " ", "find", " ", 
                "solutions"}], ",", " ", 
               RowBox[{
               "I", " ", "wanna", " ", "see", " ", "how", " ", "close", " ", 
                "to", " ", "the", " ", "lifetime", " ", "of", " ", "the", " ",
                 "proton", " ", "we", " ", "can", " ", "get"}]}], " ", "*)"}],
              "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"massPassCount", "<=", "1000"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"massOnlyResults", ",", "tauEpi0"}], "]"}]}], "]"}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Acumulative", " ", "filter", " ", "for", " ", "each", " ", 
               "number", " ", "of", " ", "limits", " ", "fulfilled"}], " ", 
              "*)"}], 
             RowBox[{"isOk", "=", 
              RowBox[{"Which", "[", 
               RowBox[{
                RowBox[{"nLimits", "==", "1"}], ",", 
                RowBox[{"tauEpi0", ">", "limEpi"}], ",", 
                RowBox[{"nLimits", "==", "2"}], ",", 
                RowBox[{
                 RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
                 RowBox[{"tauMupi0", ">", "limMupi"}]}], ",", 
                RowBox[{"nLimits", "==", "3"}], ",", 
                RowBox[{
                 RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
                 RowBox[{"tauMupi0", ">", "limMupi"}], "&&", 
                 RowBox[{"tauEK0", ">", "limEK0"}]}], ",", 
                RowBox[{"nLimits", "==", "4"}], ",", 
                RowBox[{
                 RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
                 RowBox[{"tauMupi0", ">", "limMupi"}], "&&", 
                 RowBox[{"tauEK0", ">", "limEK0"}], "&&", 
                 RowBox[{"tauMuK0", ">", "limMuK0"}]}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Save", " ", "result", " ", "if", " ", "it", " ", "satisfies", 
               " ", "all", " ", "limits"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"isOk", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"safetyFactors", "=", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
                   RowBox[{"tauMupi0", "/", "limMupi"}], ",", 
                   RowBox[{"tauEK0", "/", "limEK0"}], ",", 
                   RowBox[{"tauMuK0", "/", "limMuK0"}]}], "}"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"minRobustness", "=", 
                 RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"bottleneckIdx", "=", 
                 RowBox[{
                  RowBox[{"Ordering", "[", 
                   RowBox[{"safetyFactors", ",", "1"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"bottleneck", "=", 
                 RowBox[{"channelNames", "[", 
                  RowBox[{"[", "bottleneckIdx", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"results", ",", 
                  RowBox[{"{", 
                   RowBox[{
                   "eps", ",", "Qq1", ",", "Qq2", ",", "Qq3", ",", "Ql1", ",",
                     "Ql2", ",", "Ql3", ",", "QuR1", ",", "QuR2", ",", "QuR3",
                     ",", "QdR1", ",", "QdR2", ",", "QdR3", ",", "QeR1", ",", 
                    "QeR2", ",", "QeR3", ",", "Qlq", ",", "minRobustness", 
                    ",", "bottleneck"}], "}"}]}], "]"}]}]}], "]"}], ";"}]}], 
           "]"}], ";"}], " ", 
         RowBox[{"(*", " ", 
          RowBox[{"Here", " ", "finnishes", " ", "the", " ", 
           RowBox[{"If", "[", "massCheck", "]"}]}], " ", "*)"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "numSamples"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Solutions that passed the mass filter: \>\"", ",", 
         "massPassCount"}], "]"}], ";", "\n", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"massPassCount", ">", "0"}], "&&", 
          RowBox[{
           RowBox[{"Length", "[", "results", "]"}], "==", "0"}]}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<-> Best lifetime (tauEpi0) obtained: \>\"", ",", 
           RowBox[{"ScientificForm", "[", 
            RowBox[{
             RowBox[{"Max", "[", "massOnlyResults", "]"}], ",", "3"}], "]"}], 
           ",", "\"\< years (Experimental value: \>\"", ",", 
           RowBox[{"ScientificForm", "[", 
            RowBox[{"limEpi", ",", "3"}], "]"}], ",", "\"\< )\>\""}], "]"}]}],
         "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "results", "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
