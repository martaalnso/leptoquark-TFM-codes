Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FilterSolutionsWithCKM", "[", "solutionList_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"validResults", "=", 
        RowBox[{"{", "}"}]}], ",", "q1", ",", "q2", ",", "QuR1", ",", "QuR2", 
       ",", "QuR3", ",", "QdR1", ",", "QdR2", ",", "QdR3", ",", 
       RowBox[{"eps", "=", "0.15"}], ",", "randMu", ",", "randMd", ",", "Mu", 
       ",", "Md", ",", "muDag", ",", "mdDag", ",", "eigsU", ",", "ordU", ",", 
       "VLu", ",", "eigsD", ",", "ordD", ",", "VLd", ",", "VCKM", ",", 
       "ckmCheck"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"sol", "=", 
            RowBox[{"solutionList", "[", 
             RowBox[{"[", "idx", "]"}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"q1", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", 
           RowBox[{"q2", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QuR1", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "7", "]"}], "]"}]}], ";", 
           RowBox[{"QuR2", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "8", "]"}], "]"}]}], ";", 
           RowBox[{"QuR3", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QdR1", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "10", "]"}], "]"}]}], ";", 
           RowBox[{"QdR2", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "11", "]"}], "]"}]}], ";", 
           RowBox[{"QdR3", "=", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "12", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"mass", " ", "matrices", " ", "calculation"}], " ", 
            "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"randMu", "=", 
            RowBox[{
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.5", ",", "2.0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "+", 
             RowBox[{"I", "*", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"randMd", "=", 
            RowBox[{
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.5", ",", "2.0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "+", 
             RowBox[{"I", "*", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Mu", "=", 
            RowBox[{"vHiggs", "*", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"randMu", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
                RowBox[{"eps", "^", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"q1", ",", "q2", ",", "0"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"QuR1", ",", "QuR2", ",", "QuR3"}], "}"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Md", "=", 
            RowBox[{"vHiggs", "*", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"randMd", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
                RowBox[{"eps", "^", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"q1", ",", "q2", ",", "0"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"QdR1", ",", "QdR2", ",", "QdR3"}], "}"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"muDag", "=", 
            RowBox[{"Mu", ".", 
             RowBox[{"ConjugateTranspose", "[", "Mu", "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"mdDag", "=", 
            RowBox[{"Md", ".", 
             RowBox[{"ConjugateTranspose", "[", "Md", "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"VLu", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{"Reverse", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Eigensystem", "[", "muDag", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"VLd", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{"Reverse", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Eigensystem", "[", "mdDag", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"VCKM", "=", 
            RowBox[{
             RowBox[{"ConjugateTranspose", "[", "VLu", "]"}], ".", "VLd"}]}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"ckmCheck", "=", 
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "VCKM", "]"}], "-", "V"}], ",", 
              "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ckmCheck", "<", "0.08"}], ",", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"validResults", ",", 
               RowBox[{"Prepend", "[", 
                RowBox[{
                 RowBox[{"Take", "[", 
                  RowBox[{"sol", ",", "14"}], "]"}], ",", 
                 RowBox[{"MatrixForm", "[", 
                  RowBox[{"N", "[", 
                   RowBox[{
                    RowBox[{"Abs", "[", "VCKM", "]"}], ",", "3"}], "]"}], 
                  "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"idx", ",", 
          RowBox[{"Length", "[", "solutionList", "]"}]}], "}"}]}], "]"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
