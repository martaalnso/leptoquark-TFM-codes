               RowBox[{"[", 
                RowBox[{"1", ",", 
                 RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ",", 
             RowBox[{"apariciones", "=", 
              RowBox[{"Length", "[", "grupo", "]"}]}], ",", "ckmMatrices", 
             ",", "mejorCKM"}], "}"}], ",", 
           RowBox[{
            RowBox[{"ckmMatrices", "=", 
             RowBox[{"grupo", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"mejorCKM", "=", 
