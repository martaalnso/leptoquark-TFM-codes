Cell[BoxData[
 RowBox[{
  RowBox[{"PDGValidationScan", "[", "massResults_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Qq2", "=", "6"}], ",", 
      RowBox[{"Qq3", "=", "0"}], ",", 
      RowBox[{"Ql3", "=", "0"}], ",", 
      RowBox[{"QuR3", "=", "0"}], ",", "q1", ",", "l1", ",", "l2", ",", "uR1",
       ",", "uR2", ",", "dR1", ",", "dR2", ",", "QdR3", ",", "eR1", ",", 
      "eR2", ",", "eR3", ",", "eps", ",", "qlq", ",", "y1LL", ",", "z1LL", 
      ",", "y3LL", ",", "z3LL", ",", "yEff", ",", "zEff", ",", "hEff", ",", 
      "gEff", ",", "cEff", ",", "tauEpi0", ",", "tauMupi", ",", "tauNuPi", 
      ",", "tauNuK", ",", "tauEK0", ",", "tauMuK0", ",", "isOk", ",", 
      "safetyFactors", ",", "minRobustness", ",", "bottleneckIdx", ",", 
      "criticalChannel", ",", "channelNames", ",", "results"}], "}"}], ",", 
    RowBox[{
     RowBox[{"channelNames", "=", 
      RowBox[{"{", 
       RowBox[{
       "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(e\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
        "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(\[Mu]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
        "\"\<p \[RightArrow] \[Nu] \!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\
\"", ",", 
        "\"\<p \[RightArrow] \[Nu] \!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\"", 
        ",", "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(e\), \(+\)]\) \
\!\(\*SuperscriptBox[\(K\), \(0\)]\)\>\"", ",", 
        "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(\[Mu]\), \(+\)]\) \
\!\(\*SuperscriptBox[\(K\), \(0\)]\)\>\""}], "}"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Starting PDG validation scan for \>\"", ",", 
       RowBox[{"Length", "[", "massResults", "]"}], ",", 
       "\"\< mass-filtered solutions...\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Extract", " ", "epsilon", " ", "and", " ", "charges"}], " ",
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"eps", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"q1", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"l1", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"l2", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"uR1", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"uR2", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"dR1", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"dR2", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR3", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eR1", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "10", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eR2", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "11", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eR3", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "12", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"coupling", " ", "matrices"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"y3LL", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "l1", "+", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "l2", "+", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "Ql3", "+", "qlq"}], "]"}]}]}], "}"}], 
                ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq2", "+", "l1", "+", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq2", "+", "l2", "+", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq2", "+", "Ql3", "+", "qlq"}], "]"}]}]}], "}"}],
                 ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq3", "+", "l1", "+", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq3", "+", "l2", "+", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq3", "+", "Ql3", "+", "qlq"}], "]"}]}]}], 
                 "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"z3LL", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "Qq2", "-", "qlq"}], "]"}]}], ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "Qq3", "-", "qlq"}], "]"}]}]}], "}"}], 
                ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"eps", "^", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "Qq2", "-", "qlq"}], "]"}]}]}], ",", 
                  "0", ",", 
                  RowBox[{"eps", "^", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"Qq2", "+", "Qq3", "-", "qlq"}], "]"}]}]}], "}"}],
                 ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"eps", "^", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"q1", "+", "Qq3", "-", "qlq"}], "]"}]}]}], ",", 
                  RowBox[{"-", 
                   RowBox[{"eps", "^", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Qq2", "+", "Qq3", "-", "qlq"}], "]"}]}]}], ",", 
                  "0"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{"effective", " ", "matrices"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"yEff", "=", 
              RowBox[{"V", ".", "y3LL"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"zEff", "=", 
              RowBox[{"V", ".", "z3LL"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"hEff", "=", 
              RowBox[{"y3LL", ".", "U"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"gEff", "=", 
              RowBox[{"V", ".", "y3LL", ".", "U"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"cEff", "=", 
              RowBox[{"V", ".", "z3LL", ".", "V"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{"lifetime", " ", "calculations"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"tauEpi0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KEpi0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"W0EpiL", "*", 
