Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Clear", " ", "all", " ", "variables", " ", "so", " ", "they", " ", "are", 
    " ", "treated", " ", "as", " ", "symbols"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "Qq1", ",", "Ql1", ",", "Ql2", ",", "QuR1", ",", "QuR2", ",", "QdR1", 
      ",", "QdR2", ",", "QdR3", ",", "QeR1", ",", "QeR2", ",", "QeR3"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"fixed", " ", "charge", " ", "assignments"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Qq3", "=", "0"}], ";", 
    RowBox[{"Ql3", "=", "0"}], ";", 
    RowBox[{"QuR3", "=", "0"}], ";", 
    RowBox[{"Qq2", "=", "6"}], ";", 
    RowBox[{"maxCharge", "=", "15"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sistemaCargas", "=", 
     RowBox[{"And", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Rct", " ", "~", " ", "eps"}], "^", "3"}], "-", "4"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Qq2", "-", "QuR2"}], "]"}], "==", "3"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Qq2", "-", "QuR2"}], "]"}], "==", "4"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Rsc", " ", "~", " ", "eps"}], "^", "1"}], "-", "2"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Or", "[", 
        RowBox[{
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QdR2", ">", "6"}], "&&", 
            RowBox[{"QuR2", "<", "6"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "+", "QuR2"}], "==", "13"}], "||", 
            RowBox[{
             RowBox[{"QdR2", "+", "QuR2"}], "==", "14"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QdR2", "<", "6"}], "&&", 
            RowBox[{"QuR2", ">", "6"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "+", "QuR2"}], "==", "10"}], "||", 
            RowBox[{
             RowBox[{"QdR2", "+", "QuR2"}], "==", "11"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QdR2", ">", "6"}], "&&", 
            RowBox[{"QuR2", ">", "6"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "-", "QuR2"}], "==", "1"}], "||", 
            RowBox[{
             RowBox[{"QdR2", "-", "QuR2"}], "==", "2"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QdR2", "<", "6"}], "&&", 
            RowBox[{"QuR2", "<", "6"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"QuR2", "-", "QdR2"}], "==", "1"}], "||", 
            RowBox[{
             RowBox[{"QuR2", "-", "QdR2"}], "==", "2"}]}]}], "]"}]}], "]"}], 
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Vus", " ", "~", " ", "eps"}], "^", "1"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Or", "[", 
        RowBox[{
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "-", "Qq1"}], ">", "0"}], "&&", 
            RowBox[{
             RowBox[{"QdR2", "-", "Qq2"}], ">", "0"}]}], ",", 
           RowBox[{"Qq1", "==", "5"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "-", "Qq1"}], "<", "0"}], "&&", 
            RowBox[{
             RowBox[{"QdR2", "-", "Qq2"}], "<", "0"}]}], ",", 
           RowBox[{"Qq1", "==", "7"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "-", "Qq1"}], ">", "0"}], "&&", 
            RowBox[{
             RowBox[{"QdR2", "-", "Qq2"}], "<", "0"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "*", "QdR2"}], "-", "Qq1", "-", "Qq2"}], "==", 
            "1"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "-", "Qq1"}], "<", "0"}], "&&", 
            RowBox[{
             RowBox[{"QdR2", "-", "Qq2"}], ">", "0"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "*", "QdR2"}], "+", "Qq1", "+", "Qq2"}], "==", 
            "1"}]}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Rmutau", " ", "~", " ", "eps"}], "^", "3"}], "-", "5"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"QeR2", "-", "Ql2"}], "]"}], "==", "3"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"QeR2", "-", "Ql2"}], "]"}], "==", "4"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"QeR2", "-", "Ql2"}], "]"}], "==", "5"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Retau", " ", "~", " ", "eps"}], "^", "4"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"QeR1", "-", "Ql1"}], "]"}], "==", "6"}], "||", 
        RowBox[{
