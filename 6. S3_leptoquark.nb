            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"qlq", ",", "15", ",", "25"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"item", ",", "massResults"}], "}"}]}], "]"}], "]"}]}], ";", 
