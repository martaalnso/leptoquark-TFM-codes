                RowBox[{"MatrixForm", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"Abs", "[", "VCKM", "]"}], ",", "3"}], "]"}], 
                 "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"idx", ",", 
