   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "solucionesEstables", "]"}], ">", "0"}], ",", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Solutions found: \>\"", ",", 
        RowBox[{"Length", "[", "solucionesEstables", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"finalTableData", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"item", ",", 
