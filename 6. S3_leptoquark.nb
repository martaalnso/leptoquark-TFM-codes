Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Runs", " ", "the", " ", "CKM", " ", "filter", " ", "sequentially", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"e", ".", "g", "."}], ",", 
      RowBox[{"100", " ", "iterations"}]}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"runs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FilterSolutionsWithCKM", "[", "tier2", "]"}], ",", 
       RowBox[{"{", "100", "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "all", " ", "valid", " ", "rows"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"todasLasFilas", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"runs", ",", "1"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Group", " ", "by", " ", "configuration", " ", 
     RowBox[{"(", 
      RowBox[{
      "eps", ",", "charges", ",", "qlq", ",", "robustness", ",", "channel"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"agrupado", "=", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"todasLasFilas", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "15"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Process", " ", 
     RowBox[{"results", ":", 
      RowBox[{
      "count", " ", "appearances", " ", "and", " ", "find", " ", "the", " ", 
       "best", " ", "CKM", " ", "matrix"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"resultadosProcesados", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"grupo", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cargas", "=", 
              RowBox[{"grupo", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", 
                 RowBox[{"1", ";;", "15"}]}], "]"}], "]"}]}], ",", 
             RowBox[{"apariciones", "=", 
              RowBox[{"Length", "[", "grupo", "]"}]}], ",", "ckmMatrices", 
             ",", "mejorCKM"}], "}"}], ",", 
           RowBox[{
            RowBox[{"ckmMatrices", "=", 
             RowBox[{"grupo", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"mejorCKM", "=", 
             RowBox[{
              RowBox[{"MinimalBy", "[", 
               RowBox[{"ckmMatrices", ",", 
                RowBox[{"Function", "[", 
                 RowBox[{"matForm", ",", 
                  RowBox[{"Module", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"mat", "=", 
                    RowBox[{"First", "[", "matForm", "]"}]}], "}"}], ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"mat", "-", "V"}], ",", "Infinity"}], "]"}]}], 
                   "]"}]}], "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"apariciones", ",", "cargas", ",", "mejorCKM"}], 
             "}"}]}]}], "]"}]}], "]"}], ",", "agrupado"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Filter", " ", "solutions", " ", "that", " ", "pass", " ", "at", " ", 
     "least", " ", "the", " ", "criteria"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solucionesEstables", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"resultadosProcesados", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ">=", "40"}], "&"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "final", " ", "table"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "solucionesEstables", "]"}], ">", "0"}], ",", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Solutions found: \>\"", ",", 
        RowBox[{"Length", "[", "solucionesEstables", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"finalTableData", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"item", ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ap", "=", 
                RowBox[{"item", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"cargas", "=", 
                RowBox[{"item", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ",", 
               RowBox[{"ckm", "=", 
                RowBox[{"item", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", 
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"Append", "[", 
                RowBox[{"cargas", ",", "ckm"}], "]"}], ",", 
               RowBox[{
                RowBox[{"ToString", "[", "ap", "]"}], "<>", 
                "\"\</100\>\""}]}], "]"}]}], "]"}]}], "]"}], ",", 
         "solucionesEstables"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"TableForm", "[", 
        RowBox[{"finalTableData", ",", 
         RowBox[{"TableHeadings", "->", 
          RowBox[{"{", 
