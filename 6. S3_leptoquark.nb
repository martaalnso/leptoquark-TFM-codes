        RowBox[{
         RowBox[{"Qq2", "-", "QuR2"}], "==", 
         RowBox[{"-", "4"}]}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Rsc", " ", "~", " ", "eps"}], "^", "1"}], "-", "2"}], " ", 
