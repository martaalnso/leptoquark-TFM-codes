             ";", "\[IndentingNewLine]", 
             RowBox[{"RbtTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq3"}], "+", "QdR3"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq3"}], "+", "QuR3"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"RemuTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "l1"}], "+", "eR1"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "l2"}], "+", "eR2"}], "]"}], ")"}]}]}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"RmutauTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "l2"}], "+", "eR2"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Ql3"}], "+", "eR3"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", "check", " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"massCheck", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RucTeo", "/", "Ruc"}], "<=", "tol"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RctTeo", "/", "Rct"}], "<=", "tol"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RdsTeo", "/", "Rds"}], "<=", "tol"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RsbTeo", "/", "Rsb"}], "<=", "tol"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RbtTeo", "/", "Rbt"}], "<=", "tol"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RemuTeo", "/", "Remu"}], "<=", "tol"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "tol"}], "<=", 
                 RowBox[{"RmutauTeo", "/", "Rmutau"}], "<=", "tol"}], 
                ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"massCheck", ",", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"Store", " ", "epsilon", " ", "first"}], ",", 
                 RowBox[{
                 "followed", " ", "by", " ", "the", " ", "charges"}]}], 
                "*)"}], "\[IndentingNewLine]", 
               RowBox[{"Sow", "[", 
                RowBox[{"{", 
                 RowBox[{
                 "eps", ",", "q1", ",", "l1", ",", "l2", ",", "uR1", ",", 
                  "uR2", ",", "dR1", ",", "dR2", ",", "QdR3", ",", "eR1", ",",
