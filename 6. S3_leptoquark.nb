Cell[CellGroupData[{

Cell["Core", "Subsection",
 CellChangeTimes->{{3.996575960843096*^9, 
  3.996575961177498*^9}},ExpressionUUID->"3a0dbd26-67ab-aa42-8380-\
26634d984746"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FilterSolutionsWithCKM", "[", "solutionList_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"validResults", "=", 
       RowBox[{"{", "}"}]}], ",", "q1", ",", "l1", ",", "l2", ",", "QuR1", 
      ",", "QuR2", ",", 
      RowBox[{"QuR3", "=", "0"}], ",", "QdR1", ",", "QdR2", ",", "QdR3", ",", 
      RowBox[{"Qq2", "=", "6"}], ",", 
      RowBox[{"Qq3", "=", "0"}], ",", "eps", ",", "randMu", ",", "randMd", 
      ",", "Mu", ",", "Md", ",", "muDag", ",", "mdDag", ",", "VLu", ",", 
      "VLd", ",", "VCKM", ",", "ckmCheck"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sol", "=", 
           RowBox[{"solutionList", "[", 
            RowBox[{"[", "idx", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{"extract", " ", "eps", " ", "and", " ", "charges"}], "*)"}], 
         RowBox[{
          RowBox[{"eps", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", 
          RowBox[{"q1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", 
          RowBox[{"l1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", 
          RowBox[{"l2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QuR1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QuR2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR3", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"CKM", " ", "matrix", " ", "calculation"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"randMu", "=", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", "2.0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "+", 
            RowBox[{"I", "*", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"randMd", "=", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", "2.0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "+", 
            RowBox[{"I", "*", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Mu", "=", 
           RowBox[{"vHiggs", "*", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"randMu", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"q1", ",", "Qq2", ",", "Qq3"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"QuR1", ",", "QuR2", ",", "QuR3"}], "}"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Md", "=", 
           RowBox[{"vHiggs", "*", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"randMd", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"q1", ",", "Qq2", ",", "Qq3"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"QdR1", ",", "QdR2", ",", "QdR3"}], "}"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"muDag", "=", 
           RowBox[{"Mu", ".", 
            RowBox[{"ConjugateTranspose", "[", "Mu", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"mdDag", "=", 
           RowBox[{"Md", ".", 
            RowBox[{"ConjugateTranspose", "[", "Md", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"VLu", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Reverse", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Eigensystem", "[", "muDag", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"VLd", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Reverse", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Eigensystem", "[", "mdDag", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"VCKM", "=", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "VLu", "]"}], ".", "VLd"}]}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", "check", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"ckmCheck", "=", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "VCKM", "]"}], "-", "V"}], ",", 
             "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ckmCheck", "<", "0.08"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"validResults", ",", 
              RowBox[{"Append", "[", 
               RowBox[{"sol", ",", 
                RowBox[{"MatrixForm", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"Abs", "[", "VCKM", "]"}], ",", "3"}], "]"}], 
                 "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"idx", ",", 
         RowBox[{"Length", "[", "solutionList", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "validResults"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9976132026033535`*^9, 
  3.9976132351106834`*^9}},ExpressionUUID->"5ea935f5-8dcc-4a42-b9e2-\
f7d399980163"]
}, Open  ]],

