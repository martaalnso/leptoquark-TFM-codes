        RowBox[{
         RowBox[{
          RowBox[{"Rut", " ", "~", " ", "eps"}], "^", "6"}], "-", "7"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Qq1", "-", "QuR1"}], "]"}], "==", "6"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Qq1", "-", "QuR1"}], "]"}], "==", "7"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Rdu", " ", "~", " ", "eps"}], "^", "0"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Or", "[", 
        RowBox[{
         RowBox[{"And", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Or", "[", 
            RowBox[{
             RowBox[{"And", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"QdR1", "-", "Qq1"}], ">", "0"}], ",", 
               RowBox[{
                RowBox[{"QuR1", "-", "Qq1"}], ">", "0"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"And", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"QdR1", "-", "Qq1"}], "<", "0"}], ",", 
               RowBox[{
                RowBox[{"QuR1", "-", "Qq1"}], "<", "0"}]}], "]"}]}], "]"}], 
           ",", 
           RowBox[{"QuR1", "==", "QdR1"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{"Or", "[", 
            RowBox[{
