Cell[BoxData[
 RowBox[{
  RowBox[{"MassScan", "[", 
   RowBox[{"pares_", ",", "step_", ",", 
    RowBox[{"epsMin_", ":", "0.1"}], ",", 
    RowBox[{"epsMax_", ":", "0.3"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Qq2", "=", "6"}], ",", 
      RowBox[{"Qq3", "=", "0"}], ",", 
      RowBox[{"Ql3", "=", "0"}], ",", 
      RowBox[{"QuR3", "=", "0"}], ",", 
      RowBox[{"QdR3", "=", "2"}], ",", 
      RowBox[{"tol", "=", "2.5"}], ",", "q1", ",", "l1", ",", "l2", ",", 
      "uR1", ",", "uR2", ",", "dR1", ",", "dR2", ",", "eR1", ",", "eR2", ",", 
      "eR3", ",", "RucTeo", ",", "RctTeo", ",", "RdsTeo", ",", "RsbTeo", ",", 
      "RbtTeo", ",", "RemuTeo", ",", "RmutauTeo", ",", "massCheck", ",", 
      "results", ",", "validSolutions"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Starting mass scan for \>\"", ",", 
       RowBox[{"Length", "[", "pares", "]"}], ",", 
       "\"\< charge sets (step = \>\"", ",", "step", ",", "\"\<)...\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Index", " ", "extraction", " ", "of", " ", "the", " ", "charges"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"q1", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"l1", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"l2", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"uR1", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"uR2", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"dR1", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"dR2", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eR1", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eR2", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eR3", "=", 
           RowBox[{"cargaSol", "[", 
            RowBox[{"[", "10", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", "ratios", " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RucTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "q1"}], "+", "uR1"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq2"}], "+", "uR2"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"RctTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq2"}], "+", "uR2"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq3"}], "+", "QuR3"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"RdsTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "q1"}], "+", "dR1"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq2"}], "+", "dR2"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"RsbTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq2"}], "+", "dR2"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq3"}], "+", "QdR3"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"RbtTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq3"}], "+", "QdR3"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Qq3"}], "+", "QuR3"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"RemuTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "l1"}], "+", "eR1"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "l2"}], "+", "eR2"}], "]"}], ")"}]}]}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"RmutauTeo", "=", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "l2"}], "+", "eR2"}], "]"}], ")"}]}], "/", 
               RowBox[{"eps", "^", 
                RowBox[{"(", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"-", "Ql3"}], "+", "eR3"}], "]"}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", "check", " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"massCheck", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
