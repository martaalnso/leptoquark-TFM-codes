Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Runs", " ", "the", " ", "CKM", " ", "filter", " ", "sequentially", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"e", ".", "g", "."}], ",", " ", 
      RowBox[{"100", " ", "iterations"}]}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"runs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FilterSolutionsWithCKM", "[", "tier1", "]"}], ",", 
       RowBox[{"{", "100", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "all", " ", "valid", " ", "rows"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"todasLasFilas", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"runs", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Group", " ", "by", " ", "configuration", " ", 
     RowBox[{"(", 
      RowBox[{"eps", ",", "charges", ",", "qlq", ",", "robustness"}], ")"}]}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"agrupado", "=", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"todasLasFilas", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", "14"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Process", " ", 
     RowBox[{"results", ":", " ", 
      RowBox[{
      "count", " ", "appearances", " ", "and", " ", "find", " ", "the", " ", 
       "best", " ", "CKM", " ", "matrix"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultadosProcesados", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"grupo", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cargas", "=", 
              RowBox[{"grupo", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", 
                 RowBox[{"2", ";;", "15"}]}], "]"}], "]"}]}], ",", 
             RowBox[{"apariciones", "=", 
              RowBox[{"Length", "[", "grupo", "]"}]}], ",", "ckmMatrices", 
             ",", "mejorCKM"}], "}"}], ",", 
           RowBox[{
            RowBox[{"ckmMatrices", "=", 
             RowBox[{"grupo", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"mejorCKM", "=", 
             RowBox[{
              RowBox[{"MinimalBy", "[", 
               RowBox[{"ckmMatrices", ",", 
                RowBox[{"Function", "[", 
                 RowBox[{"matForm", ",", 
                  RowBox[{"Module", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"mat", "=", 
                    RowBox[{"First", "[", "matForm", "]"}]}], "}"}], ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"mat", "-", "V"}], ",", "Infinity"}], "]"}]}], 
                   "]"}]}], "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"apariciones", ",", "cargas", ",", "mejorCKM"}], 
             "}"}]}]}], "]"}]}], "]"}], ",", "agrupado"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Filter", " ", "solutions", " ", "that", " ", "pass", " ", "at", " ", 
     "least", " ", "the", " ", "criteria"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solucionesEstables", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"resultadosProcesados", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ">=", "38"}], "&"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"-", 
