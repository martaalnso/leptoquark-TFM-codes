             RowBox[{"QdR2", "+", "QuR2"}], "==", "11"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QdR2", ">", "6"}], "&&", 
            RowBox[{"QuR2", ">", "6"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"QdR2", "-", "QuR2"}], "==", "1"}], "||", 
