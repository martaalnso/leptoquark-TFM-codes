       RowBox[{"QeR1", ">=", "QeR2"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "ranges", " ", "*)"}], "\[IndentingNewLine]", 
