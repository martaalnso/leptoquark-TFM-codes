                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                    RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                    RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
                   "^", "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tauEK0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KEK0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "2", "]"}], "*", 
                    RowBox[{"cEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                    RowBox[{"y3LL", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], "^", 
                   "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tauMuK0", "=", 
              RowBox[{"hbary", "/", 
               RowBox[{"(", 
                RowBox[{"KMuK0", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "2", "]"}], "*", 
                    RowBox[{"cEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                    RowBox[{"y3LL", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}], "^", 
                   "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", "check", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"isOk", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"tauEpi0", ">", "limEpi"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{"tauMupi", ">", "limMupi"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{"tauNuPi", ">", "limNuPi"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{"tauNuK", ">", "limNuK"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{"tauEK0", ">", "limEK0"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{"tauMuK0", ">", "limMuK0"}], ")"}]}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"isOk", ",", 
               RowBox[{
                RowBox[{"safetyFactors", "=", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
                   RowBox[{"tauMupi", "/", "limMupi"}], ",", 
                   RowBox[{"tauNuPi", "/", "limNuPi"}], ",", 
                   RowBox[{"tauNuK", "/", "limNuK"}], ",", 
                   RowBox[{"tauEK0", "/", "limEK0"}], ",", 
                   RowBox[{"tauMuK0", "/", "limMuK0"}]}], "}"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"minRobustness", "=", 
                 RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"bottleneckIdx", "=", 
                 RowBox[{
                  RowBox[{"Ordering", "[", 
                   RowBox[{"safetyFactors", ",", "1"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"criticalChannel", "=", 
                 RowBox[{"channelNames", "[", 
                  RowBox[{"[", "bottleneckIdx", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Store", " ", "eps", " ", "first"}], ",", 
                  RowBox[{"followed", " ", "by", " ", "charges"}], ",", "qlq",
                   ",", "robustness", ",", 
                  RowBox[{"and", " ", "critical", " ", "channel"}]}], "*)"}], 
                RowBox[{"Sow", "[", 
                 RowBox[{"{", 
