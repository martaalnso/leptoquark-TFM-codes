Cell[CellGroupData[{

Cell["Grid search", "Section",
 CellChangeTimes->{{3.996125181965088*^9, 3.9961251916612167`*^9}, {
  3.99612558249024*^9, 
  3.9961255844899063`*^9}},ExpressionUUID->"f9108bb7-ae0a-4d48-a3f1-\
e09c4505ee13"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eps", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chargeLimit", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"channelNames", "=", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p->\!\(\*SuperscriptBox[\(e\), \(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\
\), \(0\)]\)\>\"", ",", 
      "\"\<p->\!\(\*SuperscriptBox[\(\[Mu]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(0\)]\)\>\"", ",", 
      "\"\<p-> \!\(\*OverscriptBox[\(\[Nu]\), \(_\)]\) \
\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"", ",", 
      "\"\<p-> \!\(\*OverscriptBox[\(\[Nu]\), \(_\)]\) \
\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\""}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalIterations", "=", "0"}], ";"}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Systematic", " ", "grid", " ", "search"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gridResults", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"totalIterations", "++"}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "Reconstruct", " ", "the", " ", "coupling", " ", "matrices"}], 
         "*)"}], 
        RowBox[{"y1LL", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "l1"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "l2"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "Ql3"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q2", "+", "l1"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q2", "+", "l2"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q2", "+", "Ql3"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"Qq3", "+", "l1"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"Qq3", "+", "l2"}], "]"}]}], ",", "1"}], "}"}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"z1LL", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"2", "*", "q1"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "q2"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "Qq3"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "q2"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"2", "*", "q2"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q2", "+", "Qq3"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "Qq3"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q2", "+", "Qq3"}], "]"}]}], ",", "1"}], "}"}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Effective", " ", "matrices", " ", "and", " ", "lifetime", " ", 
          "calculations"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"yEff", "=", 
         RowBox[{"V", ".", "y1LL"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zEff", "=", 
         RowBox[{"V", ".", "z1LL"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hEff", "=", 
         RowBox[{"y1LL", ".", "U"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"tauEpi0", "=", 
         RowBox[{"hbary", "/", 
          RowBox[{"(", 
           RowBox[{"KEpi0", "*", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"zEff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"yEff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "^", "2"}]}],
            ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tauMupi", "=", 
         RowBox[{"hbary", "/", 
          RowBox[{"(", 
           RowBox[{"KMupi0", "*", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"zEff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"yEff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "^", "2"}]}],
            ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tauNuPi", "=", 
         RowBox[{"hbary", "/", 
          RowBox[{"(", 
           RowBox[{"KNupiPlus", "*", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"zEff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"hEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
                 RowBox[{"hEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
                 RowBox[{"hEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
             "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tauNuK", "=", 
         RowBox[{"hbary", "/", 
          RowBox[{"(", 
           RowBox[{"KNuK", "*", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"zEff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"hEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                 RowBox[{"hEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                 RowBox[{"hEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
             "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Check", " ", "PDG", " ", "bounds"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"isOk", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"tauEpi0", ">", "limEpi"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"tauMupi", ">", "limMupi"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"tauNuPi", ">", "limNuPi"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"tauNuK", ">", "limNuK"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"isOk", ",", 
          RowBox[{
           RowBox[{"safetyFactors", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
              RowBox[{"tauMupi", "/", "limMupi"}], ",", 
              RowBox[{"tauNuPi", "/", "limNuPi"}], ",", 
              RowBox[{"tauNuK", "/", "limNuK"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"minRobustness", "=", 
            RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"bottleneckIdx", "=", 
