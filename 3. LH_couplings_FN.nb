Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ejecution", " ", "for", " ", "x", " ", "limits", " ", "and", " ", "y", 
    " ", "iterations", " ", "and", " ", "z", " ", "maxCharge"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mysolutions", "=", 
     RowBox[{"ScanProtonDecay", "[", 
      RowBox[{"4", ",", "1000000", ",", "23"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of solutions found: \>\"", ",", 
      RowBox[{"Length", "[", "mysolutions", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sortedSolutions", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"mysolutions", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "9", "]"}], "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "mysolutions", "]"}], ">", "0"}], ",", 
     RowBox[{"TableForm", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{"sortedSolutions", ",", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Length", "[", "sortedSolutions", "]"}], ",", "10"}], 
          "]"}]}], "]"}], ",", 
       RowBox[{"TableHeadings", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<eps\>\"", ",", "\"\<Qq1\>\"", ",", "\"\<Qq2\>\"", ",", 
            "\"\<Qq3\>\"", ",", "\"\<Ql1\>\"", ",", "\"\<Ql2\>\"", ",", 
            "\"\<Ql3\>\"", ",", "\"\<vev\>\"", ",", 
            "\"\<robustness factor\>\"", ",", "\"\<less robust channel\>\""}],
            "}"}]}], "}"}]}]}], "]"}]}], "]"}]}]}]], "Input",
