Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"epsData", "=", 
   RowBox[{"mysolutions", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minVal", "=", 
   RowBox[{"Min", "[", "epsData", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxVal", "=", 
   RowBox[{"Max", "[", "epsData", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numBins", "=", "20"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", "binning", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"binEdges", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"minVal", ",", "maxVal", ",", "numBins"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"binCenters", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"binEdges", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", 
        RowBox[{"binEdges", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "binEdges", "]"}], "-", "1"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"step", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"customTicks", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"binCenters", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"binCenters", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "binCenters", "]"}], ",", "step"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "histogram", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"myPlot", "=", 
  RowBox[{"Histogram", "[", 
   RowBox[{"epsData", ",", 
    RowBox[{"{", 
     RowBox[{"minVal", ",", "maxVal", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"maxVal", "-", "minVal"}], ")"}], "/", "numBins"}]}], "}"}], 
    ",", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"Style", "[", 
      RowBox[{
      "\"\<\[Epsilon] scale distribution\>\"", ",", "18", ",", "Bold", ",", 
       "Black"}], "]"}]}], ",", 
    RowBox[{"Frame", "->", 
     RowBox[{"{", 
