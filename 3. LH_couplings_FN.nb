Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"epsData", "=", 
   RowBox[{"mysolutions", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minVal", "=", 
   RowBox[{"Min", "[", "epsData", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxVal", "=", 
   RowBox[{"Max", "[", "epsData", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numBins", "=", "20"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "los", " ", "bordes", " ", "y", " ", "los", " ", 
    "centros", " ", "de", " ", "cada", " ", "barra"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"binEdges", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"minVal", ",", "maxVal", ",", "numBins"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"binCenters", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"binEdges", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "+", 
         RowBox[{"binEdges", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{
         RowBox[{"Length", "[", "binEdges", "]"}], "-", "1"}]}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Seleccionamos", " ", "solo", " ", "un", " ", "tick", " ", "de", " ", 
    RowBox[{"cada", "'"}], 
    RowBox[{"step", "'"}], " ", 
    RowBox[{"(", 
     RowBox[{"aqu\[IAcute]", " ", "de", " ", "4", " ", "en", " ", "4"}], 
     ")"}], " ", "para", " ", "evitar", " ", "que", " ", "se", " ", 
    "amontonen"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"step", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"customTicks", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"binCenters", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"binCenters", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "binCenters", "]"}], ",", "step"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Generamos", " ", "el", " ", "histograma", " ", "con", " ", "los", " ", 
    "ticks", " ", "limpios", " ", "y", " ", "espaciados"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{"epsData", ",", 
   RowBox[{"{", 
    RowBox[{"minVal", ",", "maxVal", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"maxVal", "-", "minVal"}], ")"}], "/", "numBins"}]}], "}"}], 
   ",", 
   RowBox[{"PlotLabel", "->", "\"\<\[Epsilon] scale distribution\>\""}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
