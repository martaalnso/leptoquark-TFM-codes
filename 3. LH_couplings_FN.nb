Cell[CellGroupData[{

Cell["Monte Carlo scan", "Section",
 CellChangeTimes->{{3.996124632214903*^9, 
  3.996124636308151*^9}},ExpressionUUID->"a5123ac2-4993-e946-bb10-\
ff2ed4718dee"],

Cell[CellGroupData[{

Cell["Core", "Subsection",
 CellChangeTimes->{{3.9961246781135864`*^9, 
  3.9961246792762814`*^9}},ExpressionUUID->"2f3aed6f-fafd-4b4c-95c8-\
997b23a8576e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "function", " ", "searches", " ", "in", " ", "the", " ", 
    "parameter", " ", "space", " ", "for", " ", "variables", " ", "that", " ",
     "fit", " ", "the", " ", "PDG", " ", "limits"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ScanProtonDecay", "[", 
     RowBox[{"nLimits_", ",", "numSamples_", ",", "maxCharge_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"results", "=", 
         RowBox[{"{", "}"}]}], ",", "safetyFactors", ",", " ", 
        "minRobustness", ",", " ", "bottleneckIdx", ",", " ", "channelNames", 
        ",", "bottleneck"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"channelNames", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<p->\!\(\*SuperscriptBox[\(e\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(0\)]\)\>\"", ",", 
          "\"\<p->\!\(\*SuperscriptBox[\(\[Mu]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
          "\"\<p-> \!\(\*OverscriptBox[\(\[Nu]\), \(_\)]\) \
\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"", ",", 
          "\"\<p-> \!\(\*OverscriptBox[\(\[Nu]\), \(_\)]\) \
\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\""}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{"(*", 
         RowBox[{
         "Assign", " ", "random", " ", "values", " ", "to", " ", "the", " ", 
          "exponents"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Qq1", ",", "Qq2", ",", "Ql1", ",", "Ql2"}], "}"}], "=", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "maxCharge"}], ",", "maxCharge"}], "}"}], ",", 
             "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eps", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "3"}]}], ",", "0.25"}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Reconstruct", " ", "the", " ", "coupling", " ", "matrices"}], 
           "*)"}], 
          RowBox[{"y1LL", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Ql1"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Ql2"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Ql3"}], "]"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq2", "+", "Ql1"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq2", "+", "Ql2"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq2", "+", "Ql3"}], "]"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq3", "+", "Ql1"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq3", "+", "Ql2"}], "]"}]}], ",", "1"}], "}"}]}], 
            "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"z1LL", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"2", "*", "Qq1"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Qq2"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Qq3"}], "]"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Qq2"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"2", "*", "Qq2"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq2", "+", "Qq3"}], "]"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq1", "+", "Qq3"}], "]"}]}], ",", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Qq2", "+", "Qq3"}], "]"}]}], ",", "1"}], "}"}]}], 
            "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Effective", " ", "matrices"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"yEff", "=", 
           RowBox[{"V", ".", "y1LL"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"zEff", "=", 
           RowBox[{"V", ".", "z1LL"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"hEff", "=", 
           RowBox[{"y1LL", ".", "U"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Recalculate", " ", "lifetimes"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"tauEpi0", "=", 
           RowBox[{"hbary", "/", 
            RowBox[{"(", 
             RowBox[{"KEpi0", "*", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"zEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                 RowBox[{"yEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "^", 
               "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tauMupi", "=", 
           RowBox[{"hbary", "/", 
            RowBox[{"(", 
             RowBox[{"KMupi0", "*", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"zEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                 RowBox[{"yEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "^", 
               "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tauNuPi", "=", 
           RowBox[{"hbary", "/", 
            RowBox[{"(", 
             RowBox[{"KNupiPlus", "*", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"zEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
               "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tauNuK", "=", 
           RowBox[{"hbary", "/", 
            RowBox[{"(", 
             RowBox[{"KNuK", "*", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"zEff", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
               "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"VEV", " ", "calculation"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Vev", "=", 
           RowBox[{"eps", "*", "Lambda"}]}], ";", 
          RowBox[{"(*", "GeV", "*)"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Acumulative", " ", "filter", " ", "for", " ", "each", " ", 
            "number", " ", "of", " ", "limits", " ", "fulfilled"}], "*)"}], 
          RowBox[{"isOk", "=", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"nLimits", "==", "1"}], ",", 
             RowBox[{"tauEpi0", ">", "limEpi"}], ",", 
             RowBox[{"nLimits", "==", "2"}], ",", 
             RowBox[{
              RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
              RowBox[{"tauMupi", ">", "limMupi"}]}], ",", 
             RowBox[{"nLimits", "==", "3"}], ",", 
             RowBox[{
              RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
              RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
              RowBox[{"tauNuPi", ">", "limNuPi"}]}], ",", 
             RowBox[{"nLimits", "==", "4"}], ",", 
             RowBox[{
              RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
              RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
              RowBox[{"tauNuPi", ">", "limNuPi"}], "&&", 
              RowBox[{"tauNuK", ">", "limNuK"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"isOk", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"safetyFactors", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
                RowBox[{"tauMupi", "/", "limMupi"}], ",", 
                RowBox[{"tauNuPi", "/", "limNuPi"}], ",", 
                RowBox[{"tauNuK", "/", "limNuK"}]}], "}"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"minRobustness", "=", 
              RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"bottleneckIdx", "=", 
              RowBox[{
               RowBox[{"Ordering", "[", 
                RowBox[{"safetyFactors", ",", "1"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"bottleneck", "=", 
              RowBox[{"channelNames", "[", 
               RowBox[{"[", "bottleneckIdx", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"results", ",", 
               RowBox[{"{", 
                RowBox[{
                "eps", ",", "Qq1", ",", "Qq2", ",", "Qq3", ",", "Ql1", ",", 
                 "Ql2", ",", "Ql3", ",", "Vev", ",", "minRobustness", ",", 
                 "bottleneck"}], "}"}]}], "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", "numSamples", "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "results", "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.9961246701071396`*^9, {3.996124863208252*^9, 3.9961249565797253`*^9}, {
   3.9961262835608387`*^9, 3.996126285991123*^9}, {3.996127568957318*^9, 
   3.996127570911171*^9}, 3.996216854839878*^9, {3.996216904228327*^9, 
   3.9962169892373123`*^9}, {3.99750938873618*^9, 3.997509392205527*^9}, {
   3.997509853839382*^9, 3.9975098559580593`*^9}, {3.9975099357185783`*^9, 
   3.997509937508566*^9}},
 CellLabel->
  "In[382]:=",ExpressionUUID->"b6057e9a-5bc7-3049-aefd-2aab4ebb8e95"]
}, Open  ]],

Cell[CellGroupData[{

Cell["maxCharge evaluation", "Subsection",
 CellChangeTimes->{{3.99750959004587*^9, 
  3.9975095955230613`*^9}},ExpressionUUID->"231329e0-995e-734c-83cd-\
ea2b7387e70d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chargeThresholdTest", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mCharge", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"ScanProtonDecay", "[", 
          RowBox[{"4", ",", "1000", ",", "mCharge"}], "]"}], "]"}]}], "}"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"mCharge", ",", "10", ",", "30"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"chargeThresholdTest", ",", 
   RowBox[{"PlotMarkers", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{
     "\"\<maxCharge Optimization\>\"", ",", "18", ",", "Bold", ",", "Black"}],
      "]"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Max Charge\>\"", ",", "15", ",", "Bold", ",", "Black"}], 
       "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<Valid Solutions\>\"", ",", "15", ",", "Bold", ",", "Black"}], 
       "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Directive", "[", 
      RowBox[{"Blue", ",", "Thick"}], "]"}], "}"}]}], ",", 
   RowBox[{"AxesStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{"GridLinesStyle", "->", 
