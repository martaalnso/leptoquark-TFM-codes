 RowBox[{
  RowBox[{
   RowBox[{"gridResults", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"totalIterations", "++"}], ";", 
