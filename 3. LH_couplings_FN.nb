  3.9919716432196426`*^9}},ExpressionUUID->"207ebc2b-1132-2e48-8bd1-\
bd388802ae4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"PDG", " ", "experimental", " ", "bounds", " ", 
    RowBox[{"(", 
     RowBox[{"in", " ", "years"}], ")"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"limEpi", "=", 
     RowBox[{"2.4", "*", 
      RowBox[{"10", "^", "34"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"limMupi", "=", 
     RowBox[{"1.6", "*", 
      RowBox[{"10", "^", "34"}]}]}], ";"}], "\n", 
