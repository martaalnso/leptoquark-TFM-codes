   3.991973105246174*^9}, {3.991973147120739*^9, 3.991973162064018*^9}, {
   3.991973507704092*^9, 3.9919735079797554`*^9}, {3.991974105177534*^9, 
   3.991974260968548*^9}, 3.991975130229843*^9, {3.991984866810093*^9, 
   3.991984891146797*^9}, {3.992340744730852*^9, 3.9923407578012757`*^9}, {
   3.992400178302128*^9, 3.992400186241474*^9}, {3.9932688013283463`*^9, 
   3.9932688074319897`*^9}, {3.993273790629994*^9, 3.993273874924999*^9}, {
