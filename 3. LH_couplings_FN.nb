Cell[CellGroupData[{

Cell["Grid search", "Section",
 CellChangeTimes->{{3.996125181965088*^9, 3.9961251916612167`*^9}, {
  3.99612558249024*^9, 
  3.9961255844899063`*^9}},ExpressionUUID->"f9108bb7-ae0a-4d48-a3f1-\
e09c4505ee13"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eps", "=", "0.001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxCharge", "=", "23"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"channelNames", "=", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p->\!\(\*SuperscriptBox[\(e\), \(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\
\), \(0\)]\)\>\"", ",", 
      "\"\<p->\!\(\*SuperscriptBox[\(\[Mu]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(0\)]\)\>\"", ",", 
      "\"\<p-> \!\(\*OverscriptBox[\(\[Nu]\), \(_\)]\) \
\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"", ",", 
      "\"\<p-> \!\(\*OverscriptBox[\(\[Nu]\), \(_\)]\) \
\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\""}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"totalIterations", "=", "0"}], ";"}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Systematic", " ", "grid", " ", "search"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gridResults", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"totalIterations", "++"}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "Reconstruct", " ", "the", " ", "coupling", " ", "matrices"}], 
         "*)"}], 
        RowBox[{"y1LL", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "l1"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "l2"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q1", "+", "Ql3"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"Abs", "[", 
               RowBox[{"q2", "+", "l1"}], "]"}]}], ",", 
             RowBox[{"eps", "^", 
