      RowBox[{"mrho0", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KNurhoPlus", " ", "=", " ", 
   RowBox[{
    FractionBox["pnurho", 
     RowBox[{"16", "*", "Pi", "*", 
      RowBox[{"mp", "^", "2"}]}]], "*", 
    FractionBox[
     RowBox[{
      RowBox[{"AL", "^", "2"}], " ", "*", " ", 
      RowBox[{"W0benchmark", "^", "2"}]}], 
     RowBox[{"mLQ", "^", "4"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mp", "^", "2"}], "-", 
      RowBox[{"mrhoPlus", "^", "2"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KEomega", "=", 
   RowBox[{
    FractionBox["peomega", 
     RowBox[{"16", "*", "Pi", "*", 
      RowBox[{"mp", "^", "2"}]}]], "*", 
    FractionBox[
     RowBox[{
      RowBox[{"AL", "^", "2"}], " ", "*", " ", 
      RowBox[{"W0benchmark", "^", "2"}]}], 
     RowBox[{"mLQ", "^", "4"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mp", "^", "2"}], "+", 
      RowBox[{"me", "^", "2"}], "-", 
      RowBox[{"momega", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KMuomega", "=", 
   RowBox[{
    FractionBox["pmuomega", 
     RowBox[{"16", "*", "Pi", "*", 
      RowBox[{"mp", "^", "2"}]}]], "*", 
    FractionBox[
     RowBox[{
      RowBox[{"AL", "^", "2"}], " ", "*", " ", 
      RowBox[{"W0benchmark", "^", "2"}]}], 
     RowBox[{"mLQ", "^", "4"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mp", "^", "2"}], "+", 
      RowBox[{"mmu", "^", "2"}], "-", 
      RowBox[{"momega", "^", "2"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99197118449394*^9, 3.991971202294176*^9}, {
   3.9919713842622585`*^9, 3.9919716446168823`*^9}, {3.991971867044514*^9, 
   3.991971978067612*^9}, {3.9919720203173294`*^9, 3.991972038951723*^9}, {
   3.991972762810177*^9, 3.99197300431863*^9}, {3.9919730915051346`*^9, 
   3.991973105246174*^9}, {3.991973147120739*^9, 3.991973162064018*^9}, {
   3.991973507704092*^9, 3.9919735079797554`*^9}, {3.991974105177534*^9, 
   3.991974260968548*^9}, 3.991975130229843*^9, {3.991984866810093*^9, 
   3.991984891146797*^9}, {3.992340744730852*^9, 3.9923407578012757`*^9}, {
   3.992400178302128*^9, 3.992400186241474*^9}, {3.9932688013283463`*^9, 
   3.9932688074319897`*^9}, {3.993273790629994*^9, 3.993273874924999*^9}, {
   3.993273989463974*^9, 3.993274082250881*^9}, {3.993274151819067*^9, 
   3.99327416284359*^9}, {3.993274332006756*^9, 3.993274336323637*^9}, {
   3.993279369720196*^9, 3.993279401089205*^9}, {3.993279565018671*^9, 
   3.993279620431967*^9}, 3.993279752596857*^9, {3.993359569197459*^9, 
   3.9933595742722073`*^9}, {3.996124820294775*^9, 3.996124821898382*^9}, {
   3.996136024766857*^9, 3.996136051327801*^9}, {3.996136497856596*^9, 
