   RowBox[{
    RowBox[{"limErho", "=", 
     RowBox[{"7.2", "*", 
      RowBox[{"10", "^", "32"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"limMurho", "=", 
     RowBox[{"5.7", "*", 
      RowBox[{"10", "^", "32"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"limNurho", "=", 
     RowBox[{"1.62", "*", 
      RowBox[{"10", "^", "32"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"limEomega", "=", 
