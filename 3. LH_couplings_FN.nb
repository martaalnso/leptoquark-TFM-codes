        RowBox[{"\"\<\[Epsilon]\>\"", ",", "18", ",", "Bold", ",", "Black"}], 
        "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
        "\"\<Number of solutions\>\"", ",", "16", ",", "Bold", ",", "Black"}],
         "]"}]}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"GridLinesStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "Dotted", ",", 
       RowBox[{"Opacity", "[", "0.4", "]"}]}], "]"}]}], ",", 
    RowBox[{"FrameStyle", "->", 
