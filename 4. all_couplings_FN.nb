                    RowBox[{"zEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "+", 
                    RowBox[{"W0NuKR", "*", 
                    RowBox[{"z1RR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ")"}], "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                    RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                    RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
                "^", "2"}], " ", ")"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"VEV", " ", "calculation"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Vev", "=", 
           RowBox[{"eps", "*", "Lambda"}]}], ";", 
          RowBox[{"(*", "GeV", "*)"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Acumulative", " ", "filter", " ", "for", " ", "each", " ", 
            "number", " ", "of", " ", "limits", " ", "fulfilled"}], "*)"}], 
          RowBox[{"isOk", "=", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"nLimits", "==", "1"}], ",", 
             RowBox[{"tauEpi0", ">", "limEpi"}], ",", 
             RowBox[{"nLimits", "==", "2"}], ",", 
             RowBox[{
              RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
              RowBox[{"tauMupi", ">", "limMupi"}]}], ",", 
             RowBox[{"nLimits", "==", "3"}], ",", 
             RowBox[{
              RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
              RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
              RowBox[{"tauNuPi", ">", "limNuPi"}]}], ",", 
             RowBox[{"nLimits", "==", "4"}], ",", 
             RowBox[{
              RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
              RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
              RowBox[{"tauNuPi", ">", "limNuPi"}], "&&", 
              RowBox[{"tauNuK", ">", "limNuK"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"isOk", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"safetyFactors", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
                RowBox[{"tauMupi", "/", "limMupi"}], ",", 
                RowBox[{"tauNuPi", "/", "limNuPi"}], ",", 
                RowBox[{"tauNuK", "/", "limNuK"}]}], "}"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"minRobustness", "=", 
              RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"bottleneckIdx", "=", 
              RowBox[{
               RowBox[{"Ordering", "[", 
                RowBox[{"safetyFactors", ",", "1"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"bottleneck", "=", 
              RowBox[{"channelNames", "[", 
               RowBox[{"[", "bottleneckIdx", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"results", ",", 
               RowBox[{"{", 
                RowBox[{
                "eps", ",", "Qq1", ",", "Qq2", ",", "Qq3", ",", "Ql1", ",", 
                 "Ql2", ",", "Ql3", ",", "QuR1", ",", "QuR2", ",", "QuR3", 
                 ",", "QdR1", ",", "QdR2", ",", "QdR3", ",", "QeR1", ",", 
                 "QeR2", ",", "QeR3", ",", "minRobustness", ",", 
                 "bottleneck"}], "}"}]}], "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", "numSamples", "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"cleanResults", "=", 
        RowBox[{"DeleteDuplicates", "[", "results", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "results", "]"}]}]}], "]"}]}], ";"}]}]], "Input",
