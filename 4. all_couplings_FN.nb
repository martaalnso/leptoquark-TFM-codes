          RowBox[{"FontSize", "->", "14"}], ",", 
          RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"redSolutions", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"mysolutions", ",", 
       RowBox[{
        RowBox[{"0.001", "<=", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", "0.05"}], "&"}]}], "]"}]}], 
