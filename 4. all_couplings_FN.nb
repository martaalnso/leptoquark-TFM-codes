                    RowBox[{"[", 
                    RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
               "^", "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tauNuK", "=", 
          RowBox[{"hbary", "/", 
           RowBox[{"(", 
            RowBox[{"KNuK", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"W0NuKL", "*", 
                    RowBox[{"zEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "+", 
                   RowBox[{"W0NuKR", "*", 
                    RowBox[{"z1RR", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ")"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                   RowBox[{"hEff", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
               "^", "2"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"VEV", " ", "calculation"}], "*)"}], 
         RowBox[{"Vev", "=", 
          RowBox[{"eps", "*", "Lambda"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Cumulative", " ", "filter", " ", "for", " ", "each", " ", "number",
            " ", "of", " ", "limits", " ", "fulfilled"}], "*)"}], 
         RowBox[{"isOk", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"nLimits", "==", "1"}], ",", 
            RowBox[{"tauEpi0", ">", "limEpi"}], ",", 
            RowBox[{"nLimits", "==", "2"}], ",", 
            RowBox[{
             RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
             RowBox[{"tauMupi", ">", "limMupi"}]}], ",", 
            RowBox[{"nLimits", "==", "3"}], ",", 
            RowBox[{
             RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
             RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
             RowBox[{"tauNuPi", ">", "limNuPi"}]}], ",", 
            RowBox[{"nLimits", "==", "4"}], ",", 
            RowBox[{
             RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
             RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
             RowBox[{"tauNuPi", ">", "limNuPi"}], "&&", 
             RowBox[{"tauNuK", ">", "limNuK"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"isOk", ",", 
           RowBox[{
            RowBox[{"safetyFactors", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
               RowBox[{"tauMupi", "/", "limMupi"}], ",", 
               RowBox[{"tauNuPi", "/", "limNuPi"}], ",", 
               RowBox[{"tauNuK", "/", "limNuK"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"minRobustness", "=", 
             RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"bottleneckIdx", "=", 
             RowBox[{
              RowBox[{"Ordering", "[", 
               RowBox[{"safetyFactors", ",", "1"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"bottleneck", "=", 
             RowBox[{"channelNames", "[", 
              RowBox[{"[", "bottleneckIdx", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"results", ",", 
              RowBox[{"{", 
               RowBox[{
               "eps", ",", "Qq1", ",", "Qq2", ",", "Qq3", ",", "Ql1", ",", 
                "Ql2", ",", "Ql3", ",", "QuR1", ",", "QuR2", ",", "QuR3", ",",
                 "QdR1", ",", "QdR2", ",", "QdR3", ",", "QeR1", ",", "QeR2", 
                ",", "QeR3", ",", "minRobustness", ",", "bottleneck"}], 
               "}"}]}], "]"}]}]}], "]"}]}], ",", 
        RowBox[{"{", "numSamples", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"cleanResults", "=", 
       RowBox[{"DeleteDuplicates", "[", "results", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "cleanResults", "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9975492357900257`*^9, 3.9975493563795433`*^9}, {
  3.9975519118935947`*^9, 3.997551922650778*^9}},
