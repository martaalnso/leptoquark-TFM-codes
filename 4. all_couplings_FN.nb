       ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"channelNames", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<p->e+pi0\>\"", ",", "\"\<pi->mu+pi0\>\"", ",", 
          "\"\<pi->nupi+\>\"", ",", "\"\<p->nuK+\>\""}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
