        "bottleneckIdx", ",", "channelNames", ",", "bottleneck"}], "}"}], ",", 
     RowBox[{
      RowBox[{"channelNames", "=", 
       RowBox[{"{", 
        RowBox[{
        "\"\<p\[RightArrow]\!\(\*OverscriptBox[\(\[Nu]\), \
\(_\)]\)\!\(\*SuperscriptBox[\(e\), \(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \
\(0\)]\)\>\"", ",", 
         "\"\<p\[RightArrow]\!\(\*OverscriptBox[\(\[Nu]\), \
\(_\)]\)\!\(\*SuperscriptBox[\(\[Mu]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
         "\"\<p-\[RightArrow]\!\(\*OverscriptBox[\(\[Nu]\), \
\(_\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"", ",", 
         "\"\<p\[RightArrow]\!\(\*OverscriptBox[\(\[Nu]\), \
\(_\)]\)\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\""}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
