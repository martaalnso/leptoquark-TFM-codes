Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "function", " ", "defining", " ", "the", " ", "common", " ", "style", " ", 
    "of", " ", "all", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "myPlot", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"myPlot", "[", 
      RowBox[{"data_", ",", "title_", ",", "xLabel_", ",", "yLabel_"}], "]"}],
      ":=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"data", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Yellow", ",", 
            RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
            RowBox[{"PointSize", "[", "Medium", "]"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"Pink", ",", 
            RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
            RowBox[{"PointSize", "[", "Medium", "]"}]}], "]"}]}], "}"}]}], 
       ",", 
       RowBox[{"PlotLabel", "->", "title"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameStyle", "->", "Black"}], ",", 
       RowBox[{"FrameTicksStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "12"}], "]"}]}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "13"}], "]"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"xLabel", ",", "yLabel"}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"GridLinesStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Dashed"}], "]"}]}], 
       ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "20"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "20"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<0.001 \[LessSlantEqual] \[Epsilon] \[LessSlantEqual] 0.05\>\"", 
          ",", "\"\<\[Epsilon] > 0.05\>\""}], "}"}]}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
