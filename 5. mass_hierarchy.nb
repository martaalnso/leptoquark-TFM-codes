          Reverse[
           Part[
            Eigensystem[$CellContext`mdDag], 2], 1]]; $CellContext`VCKM = Dot[
          
          ConjugateTranspose[$CellContext`VLu], $CellContext`VLd]; \
$CellContext`tauEpi0 = $CellContext`hbary/($CellContext`KEpi0 (
          Abs[($CellContext`W0EpiL 
               Part[$CellContext`zEff, 1, 1] + $CellContext`W0EpiR 
               Part[$CellContext`z1RR, 1, 1]) 
