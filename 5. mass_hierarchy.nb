Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "runs", " ", "5000", " ", "ejecutions", " ", "of", " ", "the", " ", 
     "previous", " ", "function"}], ",", " ", 
    RowBox[{"that", " ", "is"}], ",", " ", 
    RowBox[{
    "calculates", " ", "5000", " ", "ckm", " ", "matrices", " ", "per", " ", 
     "solutions", " ", "and", " ", "checks", " ", "how", " ", "many", " ", 
     "of", " ", "them", " ", "satisfies", " ", "the", " ", "ckm", " ", 
     RowBox[{"filter", ".", " ", "Then"}], " ", "takes", " ", "the", " ", 
     "solutions", " ", "that", " ", "pass", " ", "the", " ", "filter", " ", 
     "at", " ", "least", " ", "25", "%", " ", "of", " ", "the", " ", "times", 
     " ", "and", " ", "displays", " ", "them", " ", "with", " ", "the", " ", 
     "best", " ", "ckm", " ", "matrix", " ", "calculated", " ", "in", " ", 
     "the", " ", "5000", " ", 
     RowBox[{"runs", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"runs", "=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Print", "=", 
         RowBox[{"Null", "&"}]}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FilterSolutionsWithCKM", "[", "rangedSolutions", "]"}], ",",
          "5000"}], "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"todasLasFilas", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"runs", ",", "_TableForm"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"agrupado", "=", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"todasLasFilas", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultadosProcesados", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"grupo", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cargas", "=", 
              RowBox[{"grupo", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", 
                 RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ",", 
             RowBox[{"apariciones", "=", 
              RowBox[{"Length", "[", "grupo", "]"}]}], ",", "ckmMatrices", 
             ",", "mejorCKM"}], "}"}], ",", 
           RowBox[{
            RowBox[{"ckmMatrices", "=", 
             RowBox[{"grupo", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"mejorCKM", "=", 
             RowBox[{
              RowBox[{"MinimalBy", "[", 
