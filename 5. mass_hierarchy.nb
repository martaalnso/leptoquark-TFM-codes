       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "ranges", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"-", "maxCharge"}], "<=", "Qq1", "<=", "maxCharge"}], ",", 
