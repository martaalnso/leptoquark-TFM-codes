      RowBox[{
       RowBox[{"FilterSolutionsWithCKM", "[", "tier3", "]"}], ",", 
       RowBox[{"{", "100", "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
