             Part[$CellContext`hEff, 2, 2] + 
             Part[$CellContext`hEff, 2, 
               3])]^2); $CellContext`tauEeta = \
$CellContext`hbary/($CellContext`KEeta (
          Abs[(Part[$CellContext`zEff, 1, 1] + Part[$CellContext`z1RR, 1, 1]) 
             Part[$CellContext`yEff, 1, 1]]^2 + 
          Abs[(Part[$CellContext`zEff, 1, 1] + Part[$CellContext`z1RR, 1, 1]) 
             Part[$CellContext`y1RR, 1, 
               1]]^2)); $CellContext`tauMueta = \
$CellContext`hbary/($CellContext`KMueta (
          Abs[Part[$CellContext`zEff, 1, 1] Part[$CellContext`yEff, 1, 2]]^2 + 
          Abs[Part[$CellContext`zEff, 1, 1] Part[$CellContext`y1RR, 1, 2]]^2 + 
          Abs[Part[$CellContext`z1RR, 1, 1] Part[$CellContext`yEff, 1, 2]]^2 + 
          Abs[Part[$CellContext`z1RR, 1, 1] 
             Part[$CellContext`y1RR, 1, 
