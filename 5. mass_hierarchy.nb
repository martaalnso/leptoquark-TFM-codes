             Part[$CellContext`hEff, 1, 2] + 
             Part[$CellContext`hEff, 1, 
               3])]^2); $CellContext`tauNuK = \
$CellContext`hbary/($CellContext`KNuK 
         Abs[($CellContext`W0NuKL 
              Part[$CellContext`zEff, 1, 1] + $CellContext`W0NuKR 
