              Part[$CellContext`hEff, 1, 2] + 
              Part[$CellContext`hEff, 1, 
                3])]^2)); $CellContext`tauEomega = $CellContext`tauEeta \
($CellContext`KEeta/$CellContext`KEomega); $CellContext`tauMuomega = \
$CellContext`tauMueta ($CellContext`KMueta/$CellContext`KMuomega); \
$CellContext`RctTeo = $CellContext`eps$$^
          Abs[-$CellContext`Qq2$$ + $CellContext`QuR2$$]/$CellContext`eps$$^
