         Abs[-$CellContext`Qq2$$ + $CellContext`QdR2$$]; $CellContext`RbtTeo = \
$CellContext`eps$$^
          Abs[-$CellContext`Qq3 + $CellContext`QdR3$$]/$CellContext`eps$$^
         Abs[-$CellContext`Qq3 + $CellContext`QuR3$$]; $CellContext`RemuTeo = \
$CellContext`eps$$^
          Abs[-$CellContext`Ql1$$ + $CellContext`QeR1$$]/$CellContext`eps$$^
         Abs[-$CellContext`Ql2$$ + $CellContext`QeR2$$]; \
