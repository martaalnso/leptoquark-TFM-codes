              Part[{$CellContext`QdR1$$, $CellContext`QdR2$$, \
$CellContext`QdR3$$}, $CellContext`j]], {$CellContext`i, 3}, {$CellContext`j, 
            3}]; $CellContext`muDag = Dot[$CellContext`Mu, 
