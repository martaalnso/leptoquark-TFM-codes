Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "function", " ", "searches", " ", "in", " ", "the", " ", 
    "parameter", " ", "space", " ", "for", " ", "variables", " ", "that", " ",
     "fit", " ", "the", " ", "PDG", " ", "limits", " ", "AND", " ", "the", 
    " ", "Mass", " ", "Ratios"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ScanProtonDecay", "[", 
     RowBox[{"nLimits_", ",", "numSamples_", ",", "maxCharge_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"results", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"massOnlyResults", "=", 
         RowBox[{"{", "}"}]}], ",", "tol", ",", "RctTeo", ",", "RutTeo", ",", 
        "RsbTeo", ",", "RdbTeo", ",", "massCheck", ",", 
        RowBox[{"massPassCount", "=", "0"}], ",", " ", "safetyFactors", ",", 
        "minRobustness", ",", "bottleneckIdx", ",", "channelNames", ",", 
        "bottleneck"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tol", "=", "5.0"}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"tolerance", " ", "O", 
         RowBox[{"(", "1", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"channelNames", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(e\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
          "\"\<p \[RightArrow] \!\(\*SuperscriptBox[\(\[Mu]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
          "\"\<p \[RightArrow] \!\(\*OverscriptBox[\(\[Nu]\), \
\(_\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"", ",", 
          "\"\<p \[RightArrow] \!\(\*OverscriptBox[\(\[Nu]\), \
\(_\)]\)\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\""}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Assign", " ", "ordered", " ", "random", " ", "values", " ", "to", 
          " ", "the", " ", "charges", " ", "but", " ", "ordered", " ", "for", 
          " ", "the", " ", "solution", " ", "to", " ", "be", " ", "as", " ", 
          "physical", " ", "as", " ", "possible", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Gen", " ", "1"}], ">", 
            RowBox[{"Gen", " ", "2"}], ">", 
            RowBox[{"Gen", " ", "3"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Qq1", ",", "Qq2"}], "}"}], "=", 
            RowBox[{"ReverseSort", "[", 
             RowBox[{"RandomSample", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", "maxCharge"}], "]"}], ",", "2"}], "]"}], 
             "]"}]}], ";", "\n", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Ql1", ",", "Ql2"}], "}"}], "=", 
            RowBox[{"ReverseSort", "[", 
             RowBox[{"RandomSample", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", "maxCharge"}], "]"}], ",", "2"}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"QuR3", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "2"}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"QuR2", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"QuR3", "+", "1"}], ",", 
               RowBox[{"maxCharge", "-", "1"}]}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"QuR1", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"QuR2", "+", "1"}], ",", "maxCharge"}], "}"}], "]"}]}],
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"QdR3", "=", 
            RowBox[{"QuR3", "+", "2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QdR2", "=", 
            RowBox[{"1", "+", "QuR2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QdR1", "=", "QuR1"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"QeR2", "=", 
            RowBox[{"1", "-", "Ql2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"QeR1", "=", 
            RowBox[{"4", "-", "Ql1"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Qlq", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "20"}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"eps", "=", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0.1", ",", "0.3"}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\n", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Theorical", " ", "ratios", " ", "from", " ", "these", " ", 
             "random", " ", "charges", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "all", " ", "would", " ", "be", " ", "divided", " ", "by", " ", 
                RowBox[{"epsilon", "^", "0"}]}], "=", 
               RowBox[{
               "1", " ", "bc", " ", "we", " ", "are", " ", "normalizing", " ",
                 "to", " ", "the", " ", "3", "rd", " ", "gen", " ", "but", 
                " ", 
                RowBox[{"let", "'"}], "s", " ", "keep", " ", "it", " ", 
                "generical", " ", "in", " ", "case", " ", "we", " ", "want", 
                " ", "to", " ", "change", " ", "the", " ", "values", " ", 
                "of", " ", "the", " ", "3", "rd", " ", "generation", " ", 
                "charges"}]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"RucTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq1", "+", "QuR1"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QuR2"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RctTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QuR2"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq3", "+", "QuR3"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RdsTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq1", "+", "QdR1"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QdR2"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RsbTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq2", "+", "QdR2"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Qq3", "+", "QdR3"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RbtTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Abs", "[", 
                RowBox[{"Qq3", "+", "QdR3"}], "]"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Abs", "[", 
                RowBox[{"Qq3", "+", "QuR3"}], "]"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RemuTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql1", "+", "QeR1"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql2", "+", "QeR2"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RmutauTeo", "=", 
            RowBox[{
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql2", "+", "QeR2"}], ")"}]}], "/", 
             RowBox[{"eps", "^", 
              RowBox[{"(", 
               RowBox[{"Ql3", "+", "QeR3"}], ")"}]}]}]}], ";", 
