Cell[BoxData[
 RowBox[{
  RowBox[{"FilterSolutionsWithCKM", "[", 
   RowBox[{"solutionList_", ",", 
    RowBox[{"threshold_", ":", "0.08"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"validResults", "=", 
       RowBox[{"{", "}"}]}], ",", "q1", ",", "l1", ",", "l2", ",", "QuR1", 
      ",", "QuR2", ",", 
      RowBox[{"QuR3", "=", "0"}], ",", "QdR1", ",", "QdR2", ",", "QdR3", ",", 
      "QeR1", ",", "QeR2", ",", "QeR3", ",", "qlq", ",", 
      RowBox[{"Qq2", "=", "6"}], ",", 
      RowBox[{"Qq3", "=", "0"}], ",", "eps", ",", "randMu", ",", "randMd", 
      ",", "Mu", ",", "Md", ",", "muDag", ",", "mdDag", ",", "VLu", ",", 
      "VLd", ",", "VCKM", ",", "ckmCheck"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sol", "=", 
           RowBox[{"solutionList", "[", 
            RowBox[{"[", "idx", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "1.", " ", "Extract", " ", "eps", " ", "and", " ", "all", " ", 
           "charges", " ", "directly", " ", "from", " ", "the", " ", 
           "solution", " ", "list"}], "*)"}], 
         RowBox[{
          RowBox[{"eps", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"q1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"l1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"l2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QuR1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QuR2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QdR3", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QeR1", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "10", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QeR2", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "11", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"QeR3", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "12", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"qlq", "=", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "13", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"2.", " ", "Random", " ", "O", 
            RowBox[{"(", "1", ")"}], " ", "coefficients"}], "*)"}], 
          RowBox[{"randMu", "=", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", "2.0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "+", 
            RowBox[{"I", "*", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"randMd", "=", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", "2.0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "+", 
            RowBox[{"I", "*", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "3.", " ", "Mass", " ", "matrices", " ", "using", " ", "the", " ", 
            "dynamic", " ", "QdR3"}], "*)"}], 
          RowBox[{"Mu", "=", 
           RowBox[{"vHiggs", "*", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"randMu", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"q1", ",", "Qq2", ",", "Qq3"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"QuR1", ",", "QuR2", ",", "QuR3"}], "}"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Md", "=", 
           RowBox[{"vHiggs", "*", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"randMd", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
               RowBox[{"eps", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"q1", ",", "Qq2", ",", "Qq3"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"QdR1", ",", "QdR2", ",", "QdR3"}], "}"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"4.", " ", "Bi"}], "-", 
            RowBox[{"unitary", " ", "diagonalization"}]}], "*)"}], 
          RowBox[{"muDag", "=", 
           RowBox[{"Mu", ".", 
            RowBox[{"ConjugateTranspose", "[", "Mu", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"mdDag", "=", 
           RowBox[{"Md", ".", 
            RowBox[{"ConjugateTranspose", "[", "Md", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"VLu", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Reverse", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Eigensystem", "[", "muDag", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"VLd", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Reverse", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Eigensystem", "[", "mdDag", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"VCKM", "=", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "VLu", "]"}], ".", "VLd"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"5.", " ", "Check", " ", "CKM", " ", "threshold"}], "*)"}],
           "\[IndentingNewLine]", 
          RowBox[{"ckmCheck", "=", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "VCKM", "]"}], "-", "V"}], ",", 
             "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ckmCheck", "<", "threshold"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"validResults", ",", 
              RowBox[{"Prepend", "[", 
               RowBox[{"sol", ",", 
                RowBox[{"MatrixForm", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"Abs", "[", "VCKM", "]"}], ",", "3"}], "]"}], 
                 "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"idx", ",", 
