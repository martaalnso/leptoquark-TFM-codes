    RowBox[{"solution", " ", "generation"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"todasSoluciones", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{"sistemaCargas", ",", 
