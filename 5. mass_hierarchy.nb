        RowBox[{
         RowBox[{"Abs", "[", "QeR3", "]"}], "==", "2"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", "QeR3", "]"}], "==", "3"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Rbt", " ", "~", " ", "eps"}], "^", "2"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
