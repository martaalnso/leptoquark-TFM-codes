      "\[IndentingNewLine]", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"paresCargas", ",", 
          RowBox[{"Min", "[", 
           RowBox[{"15", ",", 
            RowBox[{"Length", "[", "paresCargas", "]"}]}], "]"}]}], "]"}], 
        ",", 
        RowBox[{"TableHeadings", "->", 
