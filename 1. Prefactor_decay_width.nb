Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"CM", " ", "momentum", " ", "for", " ", "each", " ", "channel"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pepi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "mp"}], ")"}]}], ")"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mp", "^", "2"}], "-", 
           RowBox[{"me", "^", "2"}], "-", 
           RowBox[{"mpi0", "^", "2"}]}], ")"}], "^", "2"}], "-", 
        RowBox[{"4", "*", 
         RowBox[{"me", "^", "2"}], "*", 
         RowBox[{"mpi0", "^", "2"}]}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pmupi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "mp"}], ")"}]}], ")"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mp", "^", "2"}], "-", 
           RowBox[{"mmu", "^", "2"}], "-", 
           RowBox[{"mpi0", "^", "2"}]}], ")"}], "^", "2"}], "-", 
        RowBox[{"4", "*", 
         RowBox[{"mmu", "^", "2"}], "*", 
         RowBox[{"mpi0", "^", "2"}]}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pnuPi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "mp"}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mp", "^", "2"}], "-", 
        RowBox[{"mpiPlus", "^", "2"}]}], ")"}]}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"pnuK", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "mp"}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mp", "^", "2"}], "-", 
        RowBox[{"mK", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Prefactors", " ", "calculation"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kepi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pepi", "/", 
        RowBox[{"(", 
         RowBox[{"16", "*", "Pi", "*", 
          RowBox[{"mp", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"AL", "^", "2"}], "*", 
      RowBox[{"W0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mp", "^", "2"}], "+", 
        RowBox[{"me", "^", "2"}], "-", 
        RowBox[{"mpi0", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Kmupi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pmupi", "/", 
        RowBox[{"(", 
         RowBox[{"16", "*", "Pi", "*", 
          RowBox[{"mp", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"AL", "^", "2"}], "*", 
      RowBox[{"W0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mp", "^", "2"}], "+", 
        RowBox[{"mmu", "^", "2"}], "-", 
        RowBox[{"mpi0", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Knupi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pnuPi", "/", 
        RowBox[{"(", 
         RowBox[{"16", "*", "Pi", "*", 
          RowBox[{"mp", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"AL", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"W0", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mp", "^", "2"}], "-", 
        RowBox[{"mpiPlus", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Knuk", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pnuK", "/", 
        RowBox[{"(", 
         RowBox[{"16", "*", "Pi", "*", 
          RowBox[{"mp", "^", "2"}]}], ")"}]}], ")"}], "*", 
