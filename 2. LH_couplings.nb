Cell[CellGroupData[{

Cell["Monte Carlo scanner", "Section",
 CellChangeTimes->{{3.996036428754532*^9, 
  3.99603643419709*^9}},ExpressionUUID->"998522a4-887c-5d40-895c-\
dab9417de63e"],

Cell[CellGroupData[{

Cell["Core", "Subsection",
 CellChangeTimes->{{3.9960642484819946`*^9, 
  3.9960642489225063`*^9}},ExpressionUUID->"d4bf1418-1924-484a-ad64-\
721fbd99de1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanProtonDecay", "[", 
    RowBox[{"nLimits_", ",", "numSamples_", ",", "maxexp_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"results", "=", 
        RowBox[{"{", "}"}]}], ",", "safetyFactors", ",", "minRobustness", ",",
        "bottleneckIdx", ",", "channelNames", ",", "bottleneck"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"channelNames", "=", 
       RowBox[{"{", 
        RowBox[{
        "\"\<p->e+pi0\>\"", ",", "\"\<p->mu+pi0\>\"", ",", 
         "\"\<p->nu+pi+\>\"", ",", "\"\<p->nu+K+\>\""}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Assign", " ", "random", " ", "values"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "y11", ",", "y12", ",", "y13", ",", "y21", ",", "y22", ",", "y23", 
            ",", "y31", ",", "y32"}], "}"}], "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "maxexp"}], "}"}], ",", "8"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"z11", ",", "z12", ",", "z13", ",", "z22", ",", "z23"}], 
           "}"}], "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "maxexp"}], "}"}], ",", "5"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eps", "=", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", "1"}]}], ",", "0.3"}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Reconstruct", " ", "matrices"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"y1LL", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eps", "^", "y11"}], ",", 
              RowBox[{"eps", "^", "y12"}], ",", 
              RowBox[{"eps", "^", "y13"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eps", "^", "y21"}], ",", 
              RowBox[{"eps", "^", "y22"}], ",", 
              RowBox[{"eps", "^", "y23"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eps", "^", "y31"}], ",", 
              RowBox[{"eps", "^", "y32"}], ",", "1"}], "}"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"z1LL", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eps", "^", "z11"}], ",", 
              RowBox[{"eps", "^", "z12"}], ",", 
              RowBox[{"eps", "^", "z13"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eps", "^", "z12"}], ",", 
              RowBox[{"eps", "^", "z22"}], ",", 
              RowBox[{"eps", "^", "z23"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eps", "^", "z13"}], ",", 
              RowBox[{"eps", "^", "z23"}], ",", "1"}], "}"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Effective", " ", "matrices"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"yEff", "=", 
          RowBox[{"V", ".", "y1LL"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"zEff", "=", 
          RowBox[{"V", ".", "z1LL"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"hEff", "=", 
          RowBox[{"y1LL", ".", "U"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Calculate", " ", "lifetimes"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"tauEpi0", "=", 
          RowBox[{"hbary", "/", 
           RowBox[{"(", 
            RowBox[{"KEpi0", "*", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"zEff", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                RowBox[{"yEff", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "^", 
              "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tauMupi", "=", 
          RowBox[{"hbary", "/", 
           RowBox[{"(", 
            RowBox[{"KMupi0", "*", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"zEff", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                RowBox[{"yEff", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "^", 
              "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tauNuPi", "=", 
          RowBox[{"hbary", "/", 
           RowBox[{"(", 
            RowBox[{"KNupiPlus", "*", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"zEff", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"hEff", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
                  RowBox[{"hEff", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
                  RowBox[{"hEff", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
              "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tauNuK", "=", 
          RowBox[{"hbary", "/", 
           RowBox[{"(", 
            RowBox[{"KNuK", "*", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"zEff", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"hEff", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                  RowBox[{"hEff", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                  RowBox[{"hEff", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ")"}]}], "]"}], 
              "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Check", " ", "feasibility"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"isOk", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"nLimits", "==", "1"}], ",", 
            RowBox[{"tauEpi0", ">", "limEpi"}], ",", 
            RowBox[{"nLimits", "==", "2"}], ",", 
            RowBox[{
             RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
             RowBox[{"tauMupi", ">", "limMupi"}]}], ",", 
            RowBox[{"nLimits", "==", "3"}], ",", 
            RowBox[{
             RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
             RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
             RowBox[{"tauNuPi", ">", "limNuPi"}]}], ",", 
            RowBox[{"nLimits", "==", "4"}], ",", 
            RowBox[{
             RowBox[{"tauEpi0", ">", "limEpi"}], "&&", 
             RowBox[{"tauMupi", ">", "limMupi"}], "&&", 
             RowBox[{"tauNuPi", ">", "limNuPi"}], "&&", 
             RowBox[{"tauNuK", ">", "limNuK"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"isOk", ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"robustness", " ", "of", " ", "the", " ", "solution"}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"safetyFactors", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tauEpi0", "/", "limEpi"}], ",", 
               RowBox[{"tauMupi", "/", "limMupi"}], ",", 
               RowBox[{"tauNuPi", "/", "limNuPi"}], ",", 
               RowBox[{"tauNuK", "/", "limNuK"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"minRobustness", "=", 
             RowBox[{"Min", "[", "safetyFactors", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"bottleneckIdx", "=", 
             RowBox[{
              RowBox[{"Ordering", "[", 
               RowBox[{"safetyFactors", ",", "1"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"bottleneck", "=", 
             RowBox[{"channelNames", "[", 
              RowBox[{"[", "bottleneckIdx", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", "results", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"results", ",", 
              RowBox[{"{", 
               RowBox[{
               "eps", ",", "y11", ",", "y12", ",", "y13", ",", "y21", ",", 
                "y22", ",", "y23", ",", "y31", ",", "y32", ",", "z11", ",", 
                "z12", ",", "z13", ",", "minRobustness", ",", "bottleneck"}], 
               "}"}]}], "]"}]}]}], "]"}]}], ",", 
        RowBox[{"{", "numSamples", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "results", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.996036384237179*^9, 3.996036419484371*^9, {3.996038418175504*^9, 
   3.996038421245987*^9}, {3.996038571828144*^9, 3.996038574970155*^9}, {
   3.996038906874485*^9, 3.996038941418991*^9}, {3.9960390040066566`*^9, 
   3.996039007377489*^9}, {3.9960390915878544`*^9, 3.996039095713886*^9}, {
   3.996039127148388*^9, 3.996039165237911*^9}, {3.9960392635160847`*^9, 
   3.9960392673767586`*^9}, {3.996039542715891*^9, 3.99603954335487*^9}, {
   3.9960415043993073`*^9, 3.996041508050793*^9}, {3.996042067393142*^9, 
   3.996042070921938*^9}, {3.996043208289007*^9, 3.996043210996813*^9}, {
   3.996060979153013*^9, 3.996060981551555*^9}, {3.996061534994661*^9, 
   3.996061539598579*^9}, {3.996061769767134*^9, 3.996061772040039*^9}, {
   3.9960642030875587`*^9, 3.996064215093641*^9}, 3.996064553495231*^9, {
   3.996064614074423*^9, 3.9960646361420193`*^9}, {3.9960647441840954`*^9, 
   3.996064754324213*^9}, {3.996064798269348*^9, 3.9960648066769085`*^9}, {
   3.997443588872305*^9, 3.997443589035055*^9}},
 CellLabel->
  "In[505]:=",ExpressionUUID->"ca09587c-7584-2745-9a19-51e33657499c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ejecution", "Subsection",
 CellChangeTimes->{{3.996064258609812*^9, 
  3.9960642599453316`*^9}},ExpressionUUID->"4dea3d17-84a3-db4b-9efe-\
a9ba7c982190"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mysolutions", "=", 
    RowBox[{"ScanProtonDecay", "[", 
     RowBox[{"4", ",", "100000", ",", "23"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"#", " ", "of", " ", "limits", " ", "to", " ", "fulfill"}], ",", 
    " ", 
    RowBox[{"#", " ", "of", " ", "iterations"}], ",", " ", 
    RowBox[{"maximum", " ", "exponent"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Order", " ", "results", " ", "from", " ", "less", " ", "robust", " ", 
    "to", " ", "most"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sortedSolutions", "=", 
    RowBox[{"SortBy", "[", 
     RowBox[{"mysolutions", ",", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "13", "]"}], "]"}], "&"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Choose", " ", "only", " ", "the", " ", "closest", " ", "solutions", " ", 
    "to", " ", "the", " ", "limit"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tightSolutions", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"sortedSolutions", ",", 
      RowBox[{
       RowBox[{"1", "<=", 
        RowBox[{"#", "[", 
         RowBox[{"[", "13", "]"}], "]"}], "<=", "50"}], "&"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Number of solutions found: \>\"", ",", 
     RowBox[{"Length", "[", "mysolutions", "]"}]}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Take", " ", "first", " ", "5", " ", "of", " ", "sortedSolutions"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selectedRows", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"Take", "[", 
      RowBox[{"sortedSolutions", ",", 
       RowBox[{"Min", "[", 
        RowBox[{"5", ",", 
         RowBox[{"Length", "[", "sortedSolutions", "]"}]}], "]"}]}], "]"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"TABLE", " ", "OF", " ", "SOLUTIONS"}], "*)"}]}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{"selectedRows", ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<eps\>\"", ",", "\"\<y11\>\"", ",", "\"\<y12\>\"", ",", 
        "\"\<y13\>\"", ",", "\"\<y21\>\"", ",", "\"\<y22\>\"", ",", 
        "\"\<y23\>\"", ",", "\"\<y31\>\"", ",", "\"\<y32\>\"", ",", 
        "\"\<z11\>\"", ",", "\"\<z12\>\"", ",", "\"\<z13\>\"", ",", 
        "\"\<robustness factor\>\"", ",", "\"\<less robust channel\>\""}], 
       "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.996036404826496*^9, {3.9960367709350166`*^9, 3.996036772564026*^9}, 
   3.996038427765758*^9, {3.996038561426304*^9, 3.996038561517782*^9}, {
   3.996039547609125*^9, 3.996039548038277*^9}, {3.996039655437599*^9, 
   3.9960396556053085`*^9}, {3.996041880750278*^9, 3.996041909590236*^9}, {
   3.996057637882223*^9, 3.996057664694557*^9}, {3.9960577032094383`*^9, 
