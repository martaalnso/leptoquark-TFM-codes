     RowBox[{"mLQ", "^", "4"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mp", "^", "2"}], "+", 
      RowBox[{"me", "^", "2"}], "-", 
      RowBox[{"momega", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KMuomega", "=", 
   RowBox[{
    FractionBox["pmuomega", 
     RowBox[{"16", "*", "Pi", "*", 
      RowBox[{"mp", "^", "2"}]}]], "*", 
    FractionBox[
     RowBox[{
      RowBox[{"AL", "^", "2"}], " ", "*", " ", 
      RowBox[{"W0benchmark", "^", "2"}]}], 
     RowBox[{"mLQ", "^", "4"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mp", "^", "2"}], "+", 
      RowBox[{"mmu", "^", "2"}], "-", 
      RowBox[{"momega", "^", "2"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99197118449394*^9, 3.991971202294176*^9}, {
   3.9919713842622585`*^9, 3.9919716446168823`*^9}, {3.991971867044514*^9, 
