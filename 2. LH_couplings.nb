         RowBox[{"[", 
          RowBox[{"2", ";;", "12"}], "]"}], "]"}], "]"}], "&"}], "/@", 
      "tightSolutions"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxRange", "=", 
